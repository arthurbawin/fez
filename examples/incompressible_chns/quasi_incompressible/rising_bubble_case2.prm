# Hysing case 2: eta_heavy=10, eta_light=0.1 (dynamic viscosities).
# h=1/32, dt=0.128*h, eps=0.64*h; Table 3 of the article prints eta_heavy=1.
subsection Dimension
  set dimension = 2
end
subsection Timer
  set enable timer = false
end
subsection Output
  set write vtu results = true
  set output directory = results/rising_bubble_case2/
  set output prefix = rising_bubble_case2
end
subsection Mesh
  set dealii preset mesh = rectangle
  set dealii mesh parameters = 32, 64 : 0., 0. : 1., 2. : true
  set refinement level = 1
end
subsection Time integration
  set scheme = BDF1
  # Select BDF2 here to use the second-order extension.
  set bdf start method = BDF1
  set bdf start step ratio = 0.5
  set dt = 0.004
  set t_initial = 0
  set t_end = 3
end
subsection Nonlinear solver
  set tolerance = 1e-10
  set max_iterations = 40
  set enable_line_search = true
  set analytic_jacobian = true
end
subsection Linear solver
  subsection main physics
    set method = direct_mumps
    set reuse = true
  end
end
subsection FiniteElements
  set use quads = false
  set Velocity degree = 2
  set Pressure degree = 1
  set Tracer degree = 1
  set Potential degree = 1
end
subsection Physical properties
  set number of fluids = 2
  subsection Fluid 0
    set density = 1000
    set kinematic viscosity = 0.01
  end
  subsection Fluid 1
    set density = 1
    set kinematic viscosity = 0.1
  end
  set body force = 0, -0.98
end
subsection Cahn Hilliard
  set CHNS model = quasi_incompressible
  set mobility model = degenerate_absolute
  # m(phi) = prefactor * eps^2 * abs(1-phi^2), with no density compensation.
  set degenerate absolute mobility prefactor = 0.1
  set enable density mobility compensation = false
  set enable mobility tracer limiter = false
  set surface tension = 1.96
  set interface thickness = 0.02
  set write quasi incompressible diagnostics = true
  set quasi incompressible periodic box = false
end
subsection Initial conditions
  subsection velocity
    set Function expression = 0; 0
  end
  subsection cahn hilliard tracer
    set Function constants = eps=0.02
    set Function expression = tanh((sqrt((x-0.5)^2+(y-0.5)^2)-0.25)/(sqrt(2)*eps))
  end
end
subsection Fluid boundary conditions
  set number = 4
  set fix pressure constant = false
  set enforce zero mean pressure = true
  set pressure reference point = 0.5, 0.5, 0
  subsection boundary 0
    set id = 0
    set name = x_min
    set type = slip
  end
  subsection boundary 1
    set id = 1
    set name = x_max
    set type = slip
  end
  subsection boundary 2
    set id = 2
    set name = y_min
    set type = no_slip
  end
  subsection boundary 3
    set id = 3
    set name = y_max
    set type = no_slip
  end
end
subsection CahnHilliard boundary conditions
  set number = 4
  subsection boundary 0
    set id = 0
    set name = x_min
    set type = no_flux
  end
  subsection boundary 1
    set id = 1
    set name = x_max
    set type = no_flux
  end
  subsection boundary 2
    set id = 2
    set name = y_min
    set type = no_flux
  end
  subsection boundary 3
    set id = 3
    set name = y_max
    set type = no_flux
  end
end

# Domain integrals are independent of VTU output and mesh-quality diagnostics.
subsection Postprocessing
  subsection chns conservation
    set enable = true
    set write results = true
    set output prefix = chns_conservation
    set output frequency = 1
    set precision = 16
    set verbosity = quiet
  end
  subsection chns energy
    set enable = true
    set write results = true
    set output prefix = chns_energy
    set output frequency = 1
    set precision = 16
    set verbosity = quiet
  end
  subsection chns phase energy
    set enable = true
    set write results = true
    set output prefix = chns_phase_energy
    set output frequency = 1
    set precision = 16
    set verbosity = quiet
  end
end
