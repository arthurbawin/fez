# Regression: uniform pure phase transported by a nonzero velocity.
# Aucune interface, aucune gravite ; triangles, phase/potentiel P2.
# Verifier la preservation de la phase ; pas de comparaison energetique
# entre les deux vitesses initiales interpolees dans des espaces differents.

subsection Dimension
  set dimension = 2
end

subsection Timer
  set enable timer = false
end

subsection Output
  set write vtu results    = false
  set output directory = ./results_quasi_incompressible_pure_moving/
  set output prefix    = phase_pure_mouvement
end

subsection Mesh
  set dealii preset mesh     = rectangle
  set dealii mesh parameters = 8, 8 : 0., 0. : 1., 1. : true
  set refinement level       = 1
end

subsection Time integration
  set verbosity        = quiet
  set dt               = 0.005
  set t_initial        = 0
  set t_end            = 0.02
  set scheme           = BDF2
  set bdf start method = BDF1
  set bdf start step ratio = 0.5
end

subsection Nonlinear solver
  set verbosity            = quiet
  set tolerance            = 1e-10
  set divergence_tolerance = 1e+4
  set max_iterations       = 25
  set enable_line_search   = true
  set analytic_jacobian    = true
  set compare jacobian matrix with finite differences = false
  set analytical_jacobian_absolute_tolerance = 2e-5
  set analytical_jacobian_relative_tolerance = 2e-5
end

subsection Linear solver
  subsection main physics
    set verbosity      = quiet
    set method         = direct_mumps
    set reuse          = true
  end
end

subsection FiniteElements
  set Velocity degree   = 3
  set Pressure degree   = 2
  set Tracer degree     = 2
  set Potential degree  = 2

  set use quads = false
  subsection Quadrature rule
    set rule for simplices = witherden_vincent
    set number of 1d nodes for cell quadrature = 5
    set number of 1d nodes for face quadrature = 5
  end
end

subsection Physical properties
  set number of fluids = 2
  subsection Fluid 0
    set density             = 1000
    set pressure reference  = 3
    set kinematic viscosity = 0.001
  end
  subsection Fluid 1
    set density             = 1
    set pressure reference  = 1
    set kinematic viscosity = 0.001
  end
  set body force = 0, 0
end

subsection Cahn Hilliard
  set CHNS model = quasi_incompressible
  set mobility model      = degenerate_absolute
  set degenerate absolute mobility prefactor = 0.1
  set enable density mobility compensation = false
  set write quasi incompressible diagnostics = true
  set enable mobility tracer limiter = false
  set surface tension     = 1
  set interface thickness = 0.1
end

subsection Initial conditions
  subsection velocity
    set Function expression = 64*x*x*(1-x)*(1-x)*y*(1-y)*(1-2*y); -64*x*(1-x)*(1-2*x)*y*y*(1-y)*(1-y)
  end
  subsection cahn hilliard tracer
    set Function expression = -1 # pure light phase
  end
end

subsection Fluid boundary conditions
  set number = 4
  set fix pressure constant      = false
  set enforce zero mean pressure = true
  subsection boundary 0
    set id   = 0
    set name = x_min
    set type = no_slip
  end
  subsection boundary 1
    set id   = 1
    set name = x_max
    set type = no_slip
  end
  subsection boundary 2
    set id   = 2
    set name = y_min
    set type = no_slip
  end
  subsection boundary 3
    set id   = 3
    set name = y_max
    set type = no_slip
  end
end

subsection CahnHilliard boundary conditions
  set number = 4
  subsection boundary 0
    set id   = 0
    set name = x_min
    set type = no_flux
  end
  subsection boundary 1
    set id   = 1
    set name = x_max
    set type = no_flux
  end
  subsection boundary 2
    set id   = 2
    set name = y_min
    set type = no_flux
  end
  subsection boundary 3
    set id   = 3
    set name = y_max
    set type = no_flux
  end
end
