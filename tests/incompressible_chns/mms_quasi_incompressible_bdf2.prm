# BDF2 temporal convergence: all four fields are affine in space.
# Run with dt=0.02, 0.01, 0.005 and compare the final row of time_errors.txt.
# Histories start with the original energy-stable BDF1 step.
# The exact gradient of mu+alpha*p vanishes at the boundary (rho0/rho1=20/1).

subsection Dimension
  set dimension = 2
end

subsection Timer
  set enable timer = false
end

subsection Output
  set write vtu results    = false
  set output directory = ./results_quasi_incompressible_bdf2/
  set output prefix    = solution_quasi_incompressible
end

subsection Mesh
  set dealii preset mesh     = rectangle
  set dealii mesh parameters = 2, 2 : 0., 0. : 1., 1. : true
  set refinement level       = 0
end

subsection Time integration
  set verbosity        = quiet
  set dt               = 0.02
  set t_initial        = 0
  set t_end            = 0.2
  set scheme           = BDF2
  set bdf start method = BDF1
  set bdf start step ratio = 0.5
end

subsection Nonlinear solver
  set verbosity            = quiet
  set tolerance            = 1e-10
  set divergence_tolerance = 1e+4
  set max_iterations       = 25
  set enable_line_search   = false
  set analytic_jacobian    = true
  set compare jacobian matrix with finite differences = false
  set analytical_jacobian_absolute_tolerance = 2e-5
  set analytical_jacobian_relative_tolerance = 2e-5
end

subsection Linear solver
  subsection main physics
    set verbosity      = quiet
    set method         = direct_mumps
    set reuse          = true
  end
end

subsection FiniteElements
  set Velocity degree   = 2
  set Pressure degree   = 1
  set Tracer degree     = 1
  set Potential degree  = 1
end

subsection Physical properties
  set number of fluids = 2
  subsection Fluid 0
    set density             = 20
    set pressure reference  = 3
    set kinematic viscosity = 0.001
  end
  subsection Fluid 1
    set density             = 1
    set pressure reference  = 1
    set kinematic viscosity = 0.001
  end
  set body force = 0.2, -0.3
end

subsection Cahn Hilliard
  set CHNS model = quasi_incompressible
  set mobility model      = degenerate_absolute
  set enable density mobility compensation = false
  set write quasi incompressible diagnostics = true
  set enable mobility tracer limiter = false
  set surface tension     = 1
  set interface thickness = 1
end

subsection Initial conditions
  set to mms = true
end

subsection Fluid boundary conditions
  set number = 4
  set fix pressure constant      = false
  set enforce zero mean pressure = true
  subsection boundary 0
    set id   = 0
    set name = x_min
    set type = velocity_mms
  end
  subsection boundary 1
    set id   = 1
    set name = x_max
    set type = velocity_mms
  end
  subsection boundary 2
    set id   = 2
    set name = y_min
    set type = velocity_mms
  end
  subsection boundary 3
    set id   = 3
    set name = y_max
    set type = velocity_mms
  end
end

subsection CahnHilliard boundary conditions
  set number = 4
  subsection boundary 0
    set id   = 0
    set name = x_min
    set type = dirichlet_mms
  end
  subsection boundary 1
    set id   = 1
    set name = x_max
    set type = dirichlet_mms
  end
  subsection boundary 2
    set id   = 2
    set name = y_min
    set type = dirichlet_mms
  end
  subsection boundary 3
    set id   = 3
    set name = y_max
    set type = dirichlet_mms
  end
end

subsection Exact solution
  subsection exact velocity
    set Function expression = 0.03*(1+x)*sin(2*t); -0.02*(1+y)*cos(3*t)
  end
  subsection exact pressure
    set Function expression = 0.1*(x+y-1)*cos(2*t)
  end
  subsection exact cahn hilliard tracer
    set Function expression = 0.2+0.05*x+0.03*y+0.1*sin(t)
  end
  subsection exact cahn hilliard potential
    set Function expression = 0.1+0.05*cos(2*t)+(19/21)*0.1*(x+y-1)*cos(2*t)
  end
end

subsection Manufactured solution
  set enable                 = true
  set type                   = time
  set convergence steps      = 1
  set print error at timesteps to file = true
  set error at timesteps file prefix = time_errors
  set subtract mean pressure = true

  subsection Space convergence
    set norms to compute = L2_norm
  end

  subsection Time convergence
    set norm                 = Linfty
    set use spatial mesh     = true
    set spatial mesh index   = 0
    set time step reduction  = 0.5
  end
end

subsection Debug
  set verbosity                              = verbose
  set apply exact solution                   = false
end
