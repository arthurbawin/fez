#!/bin/bash

#
# This script formats deal.II parameter files (.prm) with
# contrib/utilities/prm_tools.py: two spaces of indentation per subsection
# level, aligned '=' signs for consecutive parameter lines, an empty line
# before each subsection or comment, and merged duplicate subsections and
# parameters.
#
# The script needs to be executed from the top-level directory of the
# source tree, either as
#   ./contrib/utilities/indent-prm
# to format all .prm files in tests/ and examples/, or as
#   ./contrib/utilities/indent-prm file1.prm file2.prm ...
# to format only the given files.
#
# Note: If the script is invoked with REPORT_ONLY=true set,
#   REPORT_ONLY=true ./contrib/utilities/indent-prm
# then formatting errors will only be reported without any actual file
# changes.
#
# The script can be invoked with PYTHON to change the default Python
# interpreter, for example:
#   PYTHON=python3.12 ./contrib/utilities/indent-prm
#

if [ ! -f contrib/utilities/indent-prm ]; then
  echo "*** This script must be run from the top-level directory of fez."
  exit 1
fi

if [ ! -f contrib/utilities/indent_common.sh ]; then
  echo "*** This script requires contrib/utilities/indent_common.sh."
  exit 1
fi

source contrib/utilities/indent_common.sh

export PYTHON="${PYTHON:-python3}"
export PRM_TOOLS="contrib/utilities/prm_tools.py"

if ! [ -x "$(command -v "${PYTHON}")" ]; then
  echo "*** No Python interpreter '${PYTHON}' found."
  exit 1
fi

#
# Format a single .prm file through a temporary file, so that the file is
# only overwritten if its contents changed. A file that cannot be parsed is
# reported and left untouched. The permissions are reset afterwards, since
# the temporary file created by mktemp is only readable by its owner.
#

format_prm_file()
{
  file="${1}"
  tmpfile="$(mktemp "${TMPDIR}/$(basename "$1").tmp.XXXXXXXX")"

  if "${PYTHON}" "${PRM_TOOLS}" "${file}" "${tmpfile}"; then
    fix_or_report "${file}" "${tmpfile}" "file indented incorrectly"
    fix_permissions "${file}"
  else
    echo "    ${file}  -  could not be parsed, left unchanged"
  fi
  rm -f "${tmpfile}"
}
export -f format_prm_file

if [ $# -gt 0 ]; then
  for file in "$@"; do
    format_prm_file "${file}"
  done
else
  process "tests examples" ".*\.prm" format_prm_file
fi
