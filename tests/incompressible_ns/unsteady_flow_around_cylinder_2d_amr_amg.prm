
subsection Dimension
  set dimension = 2
end

subsection Timer
  set enable timer = false
end

subsection Output
  set write vtu results = false
end

subsection Mesh

  set dealii preset mesh     = uniform channel with cylinder
  set dealii mesh parameters = 5, 15, 5, 5 : 1 : 1 : 0.75 : 2 : 2. : true : true
  set refinement level       = 1

  subsection Adaptation
    set verbosity = verbose
    set enable    = true
    set strategy  = local refinement

    subsection Local refinement
      set variables for adaptation = velocity
      set adapt frequency          = 1
      set refinement strategy      = fixed number
      set fraction to refine       = 0.125
      set fraction to coarsen      = 0.5
    end
  end
end

subsection Time integration
  set dt        = 0.1
  set t_initial = 0
  set t_end     = 0.2
  set scheme    = BDF2
  set bdf start method = BDF1
  set bdf start step ratio = 0.5
end

subsection Nonlinear solver
  set tolerance            = 1e-6
  set divergence_tolerance = 1e+4
  set max_iterations       = 20
  set enable_line_search   = false
  set analytic_jacobian    = true
end

subsection Linear solver
  subsection main physics
    set verbosity          = quiet
    set method             = gmres
    set preconditioner     = amg
    set max iterations     = 1000
    set max krylov vectors = 100
    set ilu fill level     = 0
    set absolute tolerance = 1e-12
    set relative tolerance = 1e-6
  end
end

subsection FiniteElements
  set use quads       = true
  set Velocity degree = 1
  set Pressure degree = 1

  # Quadratic mapping for the cylinder
  set mapping degree  = 2
end

subsection Stabilization
  set enable supg = true
end

subsection Physical properties
  set number of fluids = 1
  subsection Fluid 0
    set density             = 1
    set kinematic viscosity = 0.1
  end
end

subsection Initial conditions
  subsection velocity
    set Function expression = 1; 0
  end
end

subsection Fluid boundary conditions
  set number = 5
  subsection boundary 0
    set id   = 0
    set name = inlet
    set type = input_function
    subsection u
      set Function expression = 1
    end
    subsection v
      set Function expression = 0
    end
  end
  subsection boundary 1
    set id   = 1
    set name = outlet
    set type = outflow
  end
  subsection boundary 2
    set id   = 2
    set name = cylinder
    set type = no_slip
  end
  subsection boundary 3
    set id   = 3
    set name = bottom
    set type = slip
  end
  subsection boundary 4
    set id   = 4
    set name = top
    set type = slip
  end
end