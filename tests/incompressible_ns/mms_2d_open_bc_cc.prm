#
# Cahouet-Chabard field split preconditioner (fieldsplit_schur_cc) in a steady
# problem with open (traction) boundaries, which determine the pressure
# constant: neither pinned pressure dof nor null space. The velocity block
# preconditioner is set explicitly (amg_ilu, ILU(1) smoothing). Taylor-Hood
# P2-P1. The errors match those of the first three levels of
# mms_2d_open_bc.output.
#


subsection Dimension
  set dimension = 2
end

subsection Timer
  set enable timer = false
end

subsection Output
  set write vtu results    = false
  set output directory = ../data/mms/
  set output prefix    = solution
end

subsection Mesh
  set verbosity = quiet
end

subsection Time integration
  set scheme    = stationary
end

subsection Nonlinear solver
  set verbosity            = quiet
  set tolerance            = 1e-8
  set divergence_tolerance = 1e+4
  set max_iterations       = 50
  set enable_line_search   = true
  set analytic_jacobian    = true
end

subsection Linear solver
  subsection main physics
    set verbosity          = quiet
    set method             = gmres
    set preconditioner     = fieldsplit_schur_cc

    # Tight tolerance: the errors match those of a direct solve
    set relative tolerance = 1e-10
    set absolute tolerance = 1e-14

    # Regression bound on the GMRES iterations of every solve (about twice the
    # observed maximum): if exceeded, a "GMRES did not converge" warning is
    # printed and the output comparison fails. Exact counts are not compared,
    # as they may differ slightly across platforms.
    set max iterations     = 60
    set max krylov vectors = 60

    # Explicit velocity block preconditioner: BoomerAMG with ILU smoothing,
    # whose level of fill is the ilu fill level
    set velocity block preconditioner = amg_ilu
    set ilu fill level                = 1
  end
end

subsection FiniteElements
  set Velocity degree = 2
  set Pressure degree = 1
end

subsection Physical properties
  set number of fluids = 1
  subsection Fluid 0
    set density             = 1.2345
    set kinematic viscosity = 9.8765
  end
end

subsection Initial conditions
  subsection velocity
    set Function expression = 0; 0
  end
end

subsection Fluid boundary conditions
  set number = 4
  set fix pressure constant = false
  subsection boundary 0
    set id   = 1
    set name = x_min
    set type = velocity_mms
  end
  subsection boundary 1
    set id   = 2
    set name = x_max
    set type = velocity_mms
  end
  subsection boundary 2
    set id   = 3
    set name = y_min
    set type = open_mms
  end
  subsection boundary 3
    set id   = 4
    set name = y_max
    set type = open_mms
  end
end

subsection Exact solution
  subsection exact velocity
    set Function expression = sin(pi*x)*sin(pi*x)*cos(pi*y)*sin(pi*y); cos(pi*x)*sin(pi*x)*sin(pi*y)*sin(pi*y)
  end
  subsection exact pressure
    set Function expression = sin(pi*x)*sin(pi*x)*cos(pi*y)*sin(pi*y)
  end
end

subsection Manufactured solution
  set enable            = true
  set type              = space
  set convergence steps = 3

  subsection Space convergence
    set use dealii cube mesh = true
    set norms to compute = L2_norm, Linfty_norm, H1_seminorm
  end

  subsection Time convergence
    set norm                = Linfty
    set use spatial mesh    = true
    set time step reduction = 0.5
  end
end

